### Get all expenses
GET http://localhost:5038/api/expenses


### Create expense
POST http://localhost:5038/api/expenses
Content-Type: application/json

{
    "date": "2026-09-13T00:00:00",
    "purpose": "Grocery",
    "amount": 1500,
    "billType": "Food",
    "status": "Pending",
    "type": "Expense",
    "comments": "Monthly grocery"
}

### Get all expenses
GET http://localhost:5038/api/expenses

### Update expense
PUT http://localhost:5038/api/expenses/1
Content-Type: application/json

{
    "id": 1,
    "date": "2026-09-13T00:00:00Z",
    "purpose": "Monthly Grocery",
    "amount": 1800,
    "billType": "Food",
    "status": "Paid",
    "type": "Expense",
    "comments": "Updated amount"
}

### Delete expense
DELETE http://localhost:5038/api/expenses/1

### Register User
POST http://localhost:5038/api/auth/register 
Content-Type: application/json

{
    "name": "Prahlad",
    "email": "prahlad@example.com",
    "password": "Test@12345"
}

### Login User
POST http://localhost:5038/api/auth/login
Content-Type: application/json

{
    "email": "prahlad@example.com",
    "password": "Test@12345"
}

